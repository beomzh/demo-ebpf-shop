# cp demo.env.example demo.env 후 환경에 맞게 수정한다. (demo.env 는 git 에 올라가지 않는다)
# 보통 바꿔야 하는 값은 COURIER_IP 하나뿐이다.

# ── 택배사 (필수) ─────────────────────────────────────────────
# 가상 택배사 도메인. 공인 DNS 등록 불필요 — 사내 DNS(주·보조)에 A 레코드로 자동 등록
COURIER_DOMAIN=api.courier.example
# 택배사 API IP = 외부 API 호스트(nginx)의 IP. 방화벽에 등록된 IP (예전 이름: COURIER_OLD_IP 도 읽음)
COURIER_IP=10.0.0.61

# ── 외부 PG사 · 사내 DNS ─────────────────────────────────────
# 결제 서비스(승인)가 호출하는 외부 PG사 도메인. 공인 DNS 등록 불필요
PG_DOMAIN=api.pg.example
# PG 도메인이 가리킬 IP. 비우면 COURIER_IP (택배사 호스트의 nginx 가 PG 도 응답)
PG_IP=
# 사내 DNS 주·보조는 demo-infra 의 파드 ns1-corp-dns-0(주), ns2-corp-dns-0(보조) — deploy 가 만들고 주소도 자동으로 잡는다.
# 결제·배송 서비스는 이 두 서버를 파드의 DNS 서버로 쓴다 (PG 도메인·택배사 도메인이 A 레코드로 등록됨)
# 시나리오 ② 에서 결제 서비스가 바꿔 쓸 새 PG 도메인 — 처음에는 사내 DNS 에 등록돼 있지 않다 (PG사가 새 도메인으로 옮긴 상황)
# PG_DOMAIN 과 같은 존 안의 이름으로 둔다 → 존을 가진 DNS 가 재귀·전달 설정과 상관없이 확실하게 NXDOMAIN 을 답한다
PG_UNREGISTERED_DOMAIN=api-new.pg.example

# ── 클러스터 CLI ──────────────────────────────────────────────
# auto: oc 가 있으면 oc, 없으면 kubectl  |  oc  |  kubectl
CLI=auto

# ── 이미지 ────────────────────────────────────────────────────
# ocp-internal: OpenShift 내부 레지스트리 (기본)
#   push → default route  (default-route-openshift-image-registry.apps.<도메인>/demo-shop/...)
#   pull → 내부 서비스    (image-registry.openshift-image-registry.svc:5000/demo-shop/...)
# external: 외부 레지스트리 (아래 REGISTRY 사용, push·pull 같은 주소)
REGISTRY_MODE=ocp-internal
REGISTRY=
TAG=1.0.0
# 빌드 엔진: auto(podman 우선, 없으면 docker) | podman | docker
CONTAINER_ENGINE=auto
# push 시 레지스트리 인증서 검증. OCP default route 는 보통 사설 인증서라 false
REGISTRY_TLS_VERIFY=false
# 클러스터 노드 아키텍처 (빌드 PC 가 다른 아키텍처면 에뮬레이션 필요)
PLATFORM=linux/amd64

# ── 부하 ──────────────────────────────────────────────────────
# 부하 발생기 파드 수. 파드 1개 = 초당 체크아웃 1건 + 배송 조회 1건 + 둘러보기 1건 (간격 1초 기준)
# 요청을 늘릴 때는 간격보다 파드 수로 늘린다. 배송 조회 합계 초당 10건 이하 권장 (README 6-1)
LOADGEN_REPLICAS=1
# 파드 하나의 요청 간격(초) — 체크아웃 / 배송 조회 / 둘러보기(상품·회원 조회). 0.5 미만은 권장하지 않음
LOADGEN_ORDER_INTERVAL=1
LOADGEN_TRACKING_INTERVAL=1
LOADGEN_BROWSE_INTERVAL=1
