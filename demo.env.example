# cp demo.env.example demo.env 후 환경에 맞게 수정한다. (demo.env 는 git 에 올라가지 않는다)

# 이미지 레지스트리 / 태그 (클러스터 노드가 pull 할 수 있는 곳)
REGISTRY=registry.example.com/shop-demo
TAG=1.0.0
# 컨테이너 엔진: auto(podman 우선, 없으면 docker) | podman | docker
CONTAINER_ENGINE=auto
# push 대상 레지스트리 인증서 검증 (podman 전용. OCP 내부 레지스트리 route 가 사설 인증서면 false)
REGISTRY_TLS_VERIFY=true
# 클러스터 노드 아키텍처 (Apple Silicon 에서 amd64 클러스터용으로 빌드할 때 중요)
PLATFORM=linux/amd64

# 가상 외부 택배사 API
COURIER_DOMAIN=api.courier.example
# 월요일 밤 이전에 쓰던 IP (방화벽에 등록돼 있는 IP)
COURIER_OLD_IP=10.0.0.51
# 월요일 밤 택배사가 바꾼 새 IP (방화벽에 아직 없는 IP)
COURIER_NEW_IP=10.0.0.52

# 부하 발생 간격(초) — 주문 생성 / 배송 조회
LOADGEN_ORDER_INTERVAL=1
LOADGEN_TRACKING_INTERVAL=1
