# cp demo.env.example demo.env 후 환경에 맞게 수정한다. (demo.env 는 git 에 올라가지 않는다)
# 보통 바꿔야 하는 값은 COURIER_OLD_IP, COURIER_NEW_IP 두 개뿐이다.

# ── 택배사 (필수) ─────────────────────────────────────────────
# 가상 택배사 도메인. 공인 DNS 등록 불필요 (클러스터 안 courier-dns 만 응답)
COURIER_DOMAIN=api.courier.example
# 월요일 밤 이전에 쓰던 IP = 택배사 호스트의 기본 IP (방화벽에 등록돼 있는 IP)
COURIER_OLD_IP=10.0.0.61
# 월요일 밤 택배사가 바꾼 새 IP = 택배사 호스트에 보조로 붙인 IP (방화벽에 없는 IP)
COURIER_NEW_IP=10.0.0.62

# ── 클러스터 CLI ──────────────────────────────────────────────
# auto: oc 가 있으면 oc, 없으면 kubectl  |  oc  |  kubectl
CLI=auto

# ── 이미지 ────────────────────────────────────────────────────
# ocp-internal: OpenShift 내부 레지스트리 (기본)
#   push → default route  (default-route-openshift-image-registry.apps.<도메인>/shop/...)
#   pull → 내부 서비스    (image-registry.openshift-image-registry.svc:5000/shop/...)
# external: 외부 레지스트리 (아래 REGISTRY 사용, push·pull 같은 주소)
REGISTRY_MODE=ocp-internal
REGISTRY=
TAG=1.0.0
# 빌드 엔진: auto(podman 우선, 없으면 docker) | podman | docker
CONTAINER_ENGINE=auto
# push 시 레지스트리 인증서 검증. OCP default route 는 보통 사설 인증서라 false
REGISTRY_TLS_VERIFY=false
# 클러스터 노드 아키텍처 (빌드 PC 가 다른 아키텍처면 에뮬레이션 필요)
PLATFORM=linux/amd64

# ── 부하 ──────────────────────────────────────────────────────
# 부하 발생기 파드 수. 파드 1개 = 초당 주문 생성 1건 + 배송 조회 1건 (간격 1초 기준)
# 요청을 늘릴 때는 간격보다 파드 수로 늘린다. 배송 조회 합계 초당 10건 이하 권장 (README 6-1)
LOADGEN_REPLICAS=1
# 파드 하나의 요청 간격(초) — 주문 생성 / 배송 조회. 0.5 미만은 권장하지 않음
LOADGEN_ORDER_INTERVAL=1
LOADGEN_TRACKING_INTERVAL=1
